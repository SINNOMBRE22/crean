#!/bin/bash
set -uo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

LOG_FILE="/var/log/sn-cleanup.log"

log() { echo -e "$1" | tee -a "$LOG_FILE"; }

# --- Chequeo de privilegios ---
if [[ $EUID -ne 0 ]]; then
    echo -e "${RED}[!] Este script debe ejecutarse como root (sudo).${NC}"
    exit 1
fi

# --- Espacio antes ---
get_used_kb() { df --output=used / | tail -1; }
SPACE_BEFORE=$(get_used_kb)

log "${GREEN}[+] Verificando espacio antes de limpiar...${NC}"
df -h / | awk 'NR==2 {print "Espacio usado: " $3 " de " $2 " (" $5 ")"}' | tee -a "$LOG_FILE"

log "\n${GREEN}[1/5] Limpiando caché de paquetes (APT)...${NC}"
if command -v apt-get >/dev/null 2>&1; then
    apt-get autoremove -y >> "$LOG_FILE" 2>&1
    apt-get clean >> "$LOG_FILE" 2>&1
    apt-get autoclean >> "$LOG_FILE" 2>&1
else
    log "${YELLOW}  apt-get no encontrado, saltando...${NC}"
fi

log "${GREEN}[2/5] Vaciando registros del sistema (Journald)...${NC}"
if command -v journalctl >/dev/null 2>&1; then
    journalctl --vacuum-size=50M >> "$LOG_FILE" 2>&1
else
    log "${YELLOW}  journalctl no encontrado, saltando...${NC}"
fi

log "${GREEN}[3/5] Eliminando archivos /var/log antiguos y comprimidos...${NC}"
find /var/log -type f \( -name "*.gz" -o -name "*.1" -o -name "*.old" \) -mtime +1 -delete 2>> "$LOG_FILE"

log "${GREEN}[4/5] Limpiando directorio /tmp y caché de usuario...${NC}"
# -mtime +2 evita borrar archivos temporales que algún proceso esté usando ahora mismo
find /tmp -mindepth 1 -mtime +2 -delete 2>> "$LOG_FILE"
find /var/tmp -mindepth 1 -mtime +2 -delete 2>> "$LOG_FILE"
if [[ -n "${SUDO_USER:-}" ]]; then
    USER_HOME=$(getent passwd "$SUDO_USER" | cut -d: -f6)
    rm -rf "${USER_HOME:?}"/.cache/* 2>> "$LOG_FILE"
else
    rm -rf "${HOME:?}"/.cache/* 2>> "$LOG_FILE"
fi

log "${GREEN}[5/5] Vaciando papelera y archivos temporales residuales...${NC}"
if [[ -n "${SUDO_USER:-}" ]]; then
    rm -rf "${USER_HOME:?}"/.local/share/Trash/* 2>> "$LOG_FILE"
else
    rm -rf "${HOME:?}"/.local/share/Trash/* 2>> "$LOG_FILE"
fi

# --- Espacio después ---
SPACE_AFTER=$(get_used_kb)
FREED_KB=$(( SPACE_BEFORE - SPACE_AFTER ))
FREED_MB=$(( FREED_KB / 1024 ))

log "\n${GREEN}[✔] Limpieza completada exitosamente.${NC}"
log "${GREEN}[+] Espacio liberado: ~${FREED_MB} MB${NC}"
log "${RED}[+] Espacio final disponible:${NC}"
df -h / | awk 'NR==2 {print "Espacio usado: " $3 " de " $2 " (" $5 ")"}' | tee -a "$LOG_FILE"